# ============================================================
# finora-backend/.env.production.example
# Copy to .env on your production server and fill in all values.
# NEVER commit the actual .env file — it is in .gitignore.
# ============================================================

# --- Django core ---
SECRET_KEY=<generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
DEBUG=False

# --- Allowed hosts (your production domain) ---
ALLOWED_HOSTS=api.finora.app
CSRF_TRUSTED_ORIGINS=https://api.finora.app
CORS_ALLOWED_ORIGINS=https://finora.app

# --- PostgreSQL (replace SQLite for production) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=finora_prod
DB_USER=finora_user
DB_PASSWORD=<strong-db-password>
DB_HOST=localhost
DB_PORT=5432

# --- Redis (for caching + Celery) ---
REDIS_URL=redis://127.0.0.1:6379/1

# --- Email (password reset) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=<sendgrid-api-key>
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@finora.app
FRONTEND_URL=https://finora.app

# --- Security (HTTPS only) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- External APIs ---
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
COLI_INDEX_URL=https://raw.githubusercontent.com/datasets/cost-of-living/master/data/cost-of-living.json
COUNTRIES_API_URL=https://countriesnow.space/api/v0.1/countries

